---
const { course, index, total } = Astro.props;
---
<article class="card course-card" aria-label={`Curso ${index + 1} de ${total}: ${course.name}`}>
  <div class={`course-visual course-visual--${course.visual.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} aria-hidden="true">
    <svg viewBox="0 0 420 180" role="img" aria-label="">
      <defs><linearGradient id={`course-gradient-${index}`} x1="0" x2="1" y1="0" y2="1"><stop stop-color="#67e8f9"/><stop offset="1" stop-color="#c4f269"/></linearGradient></defs>
      <path d="M0 145 110 35l70 65L295 0l125 90v90H0Z" fill={`url(#course-gradient-${index})`} opacity=".15"/>
      <circle cx="330" cy="48" r="40" fill="none" stroke="#67e8f9" stroke-width="2" opacity=".65"/>
      <circle cx="330" cy="48" r="24" fill="none" stroke="#c4f269" stroke-width="2" opacity=".65"/>
      <text x="28" y="102" fill="#f4f8fb" font-family="Arial,sans-serif" font-size="48" font-weight="800">{course.visual}</text>
      <text x="30" y="134" fill="#a8bbcc" font-family="monospace" font-size="12">GO / {course.framework}</text>
    </svg>
    {course.free && <span class="course-access course-access--free">Gratis</span>}
  </div>
  <div class="course-card-body"><span class="card-label">CURSO / {String(index + 1).padStart(2, '0')}</span><h3>{course.name}</h3><p>{course.summary}</p><span class={`course-access-label ${course.free ? 'is-free' : ''}`}>{course.access}</span><a class="card-link" href={course.href} target="_blank" rel="noopener noreferrer">Ver ficha del curso<span class="sr-only"> (abre en nueva pestaña)</span></a></div>
</article>
