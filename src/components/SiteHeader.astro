---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { profile } from '../data/portfolio.js';
const navItems = [
  ['Inicio', '/', 'fa-home'],
  ['Proyectos', '/projects.html', 'fa-project-diagram'],
  ['Cursos', '/courses.html', 'fa-graduation-cap'],
  ['Certificaciones', '/certifications.html', 'fa-certificate'],
  ['Trayectoria', '/experience.html', 'fa-route'],
  ['Sobre mí', '/about.html', 'fa-user'],
];
const normalize = (value) => (value || '/').replace(/index\.html$/, '').replace(/\/$/, '').replace(/\.html$/, '') || '/';
const here = normalize(Astro.url.pathname);
---
<header class="site-header" data-site-header>
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="Jerson Martínez, inicio">
      <BrandMark />
    </a>
    <nav class="site-nav" id="site-nav" data-site-nav aria-label="Navegación principal">
      {navItems.map(([label, href, icon]) => {
        const current = here === normalize(href);
        return (
          <a
            href={href}
            class={current ? 'is-current' : ''}
            aria-current={current ? 'page' : undefined}
          >
            <Icon name={icon} />
            <span class="nav-label">{label}</span>
          </a>
        );
      })}
      <a
        class="nav-contact"
        href={profile.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribir a Jerson por WhatsApp, abre en nueva pestaña"
      >
        <Icon name="fab fa-whatsapp" />
        <span>WhatsApp</span>
      </a>
    </nav>
    {/* El conmutador de tema y la paleta son CONTROLES, no enlaces de navegación: vivían
        dentro de <nav>, de modo que al colapsar el menú en móvil quedaban inalcanzables
        (medido: rect 0x0 con el menú cerrado). Ahora son un grupo propio, siempre visible. */}
    <div class="header-controls">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Cambiar entre tema claro y oscuro"
        aria-pressed="false"
        hidden
      >
        <Icon name="fas fa-adjust" />
        <span class="theme-toggle-label">Tema</span>
      </button>
      <button
        class="command-open"
        type="button"
        data-command-open
        aria-label="Abrir paleta de comandos (Ctrl o Cmd + K)"
        aria-keyshortcuts="Control+K Meta+K"
        hidden
      >
        <Icon name="fas fa-terminal" />
        <span class="command-open-label">Buscar</span>
        <kbd class="command-open-kbd">⌘K</kbd>
      </button>
      <button class="nav-toggle" type="button" data-nav-toggle aria-controls="site-nav" aria-expanded="false" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
    {/* El cambio de tema se anuncia a lectores de pantalla: antes sólo mutaba aria-pressed,
        que no genera aviso en todos los lectores. */}
    <p class="sr-only" role="status" aria-live="polite" data-theme-status></p>
  </div>
</header>
