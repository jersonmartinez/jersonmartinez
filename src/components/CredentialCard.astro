---
const { certification } = Astro.props;
---
<article class="card cert-provider">
  <header class="cert-provider-head"><span class="cert-provider-logo"><img src={certification.logo} width="52" height="52" alt="" loading="lazy" decoding="async" /></span><div><p class="card-label">Emisor oficial</p><h3>{certification.provider}</h3></div></header>
  <ul class="credential-badges">
    {certification.items.map((item) => <li>
      <a class="credential-badge" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.name}, ${item.level}; abrir verificación oficial en nueva pestaña`}>
        <span class="credential-code">{item.code}</span>
        <span class="credential-copy"><strong>{item.name}</strong><small>{item.level} · ID {item.credentialId}</small></span>
        <i class="fas fa-check-circle" aria-hidden="true"></i>
      </a>
    </li>)}
  </ul>
</article>
