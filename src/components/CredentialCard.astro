---
import Icon from './Icon.astro';
import type { Certification } from '../types/content';
import { DEFAULT_LOCALE, routePath, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
// Tarjeta de credenciales por proveedor. Modo por defecto (certificaciones)
// muestra todas las credenciales; modo `summary` (inicio) muestra las primeras
// `limit` y un enlace "Ver todas", reutilizando la MISMA estructura visual.
interface Props {
  certification: Certification;
  summary?: boolean;
  limit?: number;
  lang?: Lang;
}
const { certification, summary = false, limit = 3, lang = DEFAULT_LOCALE } = Astro.props;
const copy = t(lang);
const c = copy.components;
const items = summary ? certification.items.slice(0, limit) : certification.items;
const remaining = summary ? certification.items.length - items.length : 0;
const total = certification.items.length;
---
<article class={`card cert-provider${summary ? ' cert-provider--summary' : ''}`}>
  <header class="cert-provider-head">
    <span class="cert-provider-logo"><img src={certification.logo} width="52" height="52" alt="" loading="lazy" decoding="async" /></span>
    <div class="cert-provider-id">
      <p class="card-label">{c.credentialIssuer}</p>
      <h3>{certification.provider}</h3>
      <p class="cert-provider-count">{total} {total === 1 ? c.credentialOne : c.credentialMany}</p>
    </div>
  </header>
  <ul class="credential-badges" role="list" aria-label={c.credentialsAria(certification.provider)}>
    {items.map((item) => <li>
      <a class="credential-badge" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={c.credentialBadgeAria(item.name, item.level, item.credentialId)}>
        <span class="credential-code" aria-hidden="true">{item.code}</span>
        <span class="credential-copy"><strong>{item.name}</strong><small>{item.level} · ID {item.credentialId}</small></span>
        <span class="credential-verify"><Icon name="fas fa-check-circle" /><span>{c.credentialVerify}</span></span>
      </a>
    </li>)}
  </ul>
  {/* El destino se localiza: el enlace estaba fijado a `/certifications.html`, que
      desde la versión inglesa habría devuelto al visitante a la página española. */}
  {remaining > 0 && <a class="credential-more" href={routePath('certifications', lang)}>{c.credentialMore(total, certification.provider)}<span class="sr-only">{c.credentialMoreSr}</span></a>}
</article>
