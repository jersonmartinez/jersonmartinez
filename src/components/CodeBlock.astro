---
import Icon from './Icon.astro';
import { createHash } from 'node:crypto';
import { DEFAULT_LOCALE, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
// bloque de código real con resaltado por CLASES (no estilos inline, que violarían la
// CSP estricta y el test de HTML compilado). El resaltado de Shiki emite style="color:…" en cada
// span, incompatible con el gate; por eso se usa un resaltador ligero basado en clases sobre tokens.
interface Props {
  /** Contenido real y verificable a mostrar (p. ej. un extracto de un workflow del repo). */
  code: string;
  lang?: string;
  label?: string;
  href?: string;
  /** Idioma de la INTERFAZ del bloque (no del código, que es `lang`). */
  uiLang?: Lang;
}
const { code, lang = 'yaml', label, href, uiLang = DEFAULT_LOCALE } = Astro.props;
const copy = t(uiLang);
const c = copy.components;

const escapeHtml = (value: string) => value
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Resaltado mínimo y determinista por clases para YAML/HCL/sh. No ejecuta nada; sólo envuelve
// comentarios, claves, cadenas y números en <span class="tok-*">.
function highlight(src: string) {
  return src.split('\n').map((rawLine) => {
    const line = escapeHtml(rawLine);
    // comentario de línea completa
    if (/^\s*#/.test(rawLine)) return `<span class="tok-comment">${line}</span>`;
    let out = line;
    // cadenas entre comillas
    out = out.replace(/(&quot;|&#39;|["'])(.*?)\1/g, '<span class="tok-string">$1$2$1</span>');
    // clave: al inicio (YAML)
    out = out.replace(/^(\s*)([\w.-]+)(:)(\s|$)/, '$1<span class="tok-key">$2</span>$3$4');
    // números
    out = out.replace(/\b(\d+(?:\.\d+)?)\b/g, '<span class="tok-number">$1</span>');
    return out;
  }).join('\n');
}

const highlighted = highlight(code);
/**
 * Id DETERMINISTA, derivado del contenido.
 *
 * Antes era `Math.random()`, así que dos builds del MISMO commit producían un
 * `dist` distinto (comprobado: el hash de `index.html` cambia entre dos builds
 * seguidos). Eso impide verificar por comparación de bytes que una subida de
 * dependencias no altera la salida, que es justo la comprobación que hace falta
 * al actualizar el toolchain. El sufijo aleatorio no aportaba nada: sólo tiene
 * que ser único y estable dentro de la página.
 */
const codeId = `code-${createHash('sha256').update(`${lang}\u0000${label ?? ''}\u0000${code}`).digest('hex').slice(0, 8)}`;
---
<figure class="codeblock">
  {label && <figcaption class="codeblock-caption"><span class="codeblock-lang">{lang}</span> {label}{href && <a class="codeblock-source" href={href} target="_blank" rel="noopener noreferrer">{c.codeViewSource}<span class="sr-only">{copy.newTabSuffix}</span></a>}</figcaption>}
  <div class="codeblock-body">
    <button class="codeblock-copy" type="button" data-copy-target={codeId} data-copied-label={c.codeCopied} aria-label={c.codeCopyAria} hidden><Icon name="fas fa-copy" /><span class="codeblock-copy-label">{c.codeCopy}</span></button>
    <pre class="codeblock-pre" tabindex="0"><code id={codeId} class={`language-${lang}`} set:html={highlighted}></code></pre>
  </div>
</figure>
