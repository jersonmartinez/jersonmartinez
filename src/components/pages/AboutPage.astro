---
/** Página «sobre mí» en los dos idiomas. */
import Icon from '../Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollaborationModes, getCvLinks, getProfile, getStackGroups } from '../../i18n/content';
import { DEFAULT_LOCALE, routePath, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props { lang?: Lang }
const { lang = DEFAULT_LOCALE } = Astro.props;
const copy = t(lang);
const page = copy.about;
const profile = getProfile(lang);
const stackGroups = getStackGroups(lang);
const collaborationModes = getCollaborationModes(lang);
const cvLinks = getCvLinks(lang);

const profileSchema = { '@context': 'https://schema.org', '@type': 'ProfilePage', name: page.schemaName, url: `${profile.website}${routePath('about', lang)}`, dateModified: '2026-09-30', mainEntity: { '@type': 'Person', name: profile.name, jobTitle: 'DevOps Tech Lead', knowsAbout: stackGroups.flatMap((group) => group.items) } };

const homeHref = routePath('home', lang);
const selfHref = routePath('about', lang);
// Enlaces de contexto de los resultados, en el mismo orden que `page.results`.
const resultHrefs = [
  `${routePath('experience', lang)}#hotaka-ikhodi`,
  routePath('experience', lang),
  `${routePath('experience', lang)}#hotaka-ikhodi`,
  routePath('courses', lang),
];
---
<BaseLayout title={page.title} description={page.description} lang={lang} routeKey="about" breadcrumb={[[copy.nav.home, homeHref], [copy.nav.about, selfHref]]} structuredData={[profileSchema]}>
  <section class="page-hero about-hero"><div class="container"><nav class="breadcrumb" aria-label={copy.breadcrumbAria}><ol><li><a href={homeHref}>{copy.nav.home}</a></li><li><span aria-current="page">{copy.nav.about}</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {page.eyebrow}</p><h1>{page.h1}</h1><p class="lede">{page.lede(profile.yearsExperience)}</p><nav class="about-quick-links" aria-label={page.quickLinksAria}><a class="button button--ghost" href={routePath('experience', lang)}><Icon name="fas fa-route" /> {page.quickExperience}</a><a class="button button--ghost" href={routePath('projects', lang)}><Icon name="fas fa-project-diagram" /> {page.quickProjects}</a><a class="button button--ghost" href={routePath('certifications', lang)}><Icon name="fas fa-certificate" /> {page.quickCertifications}</a></nav></div></section>
  <section class="section" aria-labelledby="about-story-title"><div class="container about-layout"><article class="about-story card"><picture class="about-portrait"><source srcset="/images/profile-v2-320.avif 320w, /images/profile-v2-640.avif 640w" sizes="(max-width: 900px) 86vw, 28vw" type="image/avif"/><source srcset="/images/profile-v2-320.webp 320w, /images/profile-v2-640.webp 640w" sizes="(max-width: 900px) 86vw, 28vw" type="image/webp"/><img src="/images/profile-v2-640.jpg" width="640" height="640" alt={page.portraitAlt} loading="lazy" decoding="async"/></picture><p class="section-kicker">{page.storyKicker}</p><h2 id="about-story-title">{page.storyTitle}</h2><p>{page.storyP1}</p><p>{page.storyP2}</p><h3>{page.resultsTitle}</h3><ul class="about-results">{page.results.map((result, index) => <li><strong>{result.label}</strong>{result.body}<a href={resultHrefs[index]}>{result.cta}</a></li>)}</ul><p>{page.storyP3}</p><p>{page.storyP4}</p></article><aside class="about-aside"><div class="card about-stack-card"><p class="section-kicker">{page.stackKicker}</p><h2>{page.stackTitle}</h2><div class="stack-groups">{stackGroups.map((group) => <details><summary>{group.name}</summary><ul>{group.items.map((item) => <li>{item}</li>)}</ul></details>)}</div></div><div class="card about-credentials-card"><p class="section-kicker">{page.trustKicker}</p><h3>{page.trustTitle}</h3><p>{page.trustBody}</p><div class="about-links"><a class="card-link" href={routePath('certifications', lang)}>{page.trustCta}</a>{cvLinks.map((cv) => <a class="card-link" href={cv.href} target="_blank" rel="noopener noreferrer" hreflang={cv.lang}>{cv.label}<span class="sr-only">{copy.newTabSuffix}</span></a>)}</div></div></aside></div></section>
  <section class="section section--line" aria-labelledby="collaboration-title"><div class="container"><div class="section-heading"><p class="section-kicker">{page.collabKicker}</p><h2 id="collaboration-title">{page.collabTitle}</h2></div><div class="intent-grid">{collaborationModes.map((mode) => <article class="card card--interactive intent-card"><span class="intent-icon" aria-hidden="true"><Icon name={mode.icon} /></span><h3>{mode.title}</h3><p>{mode.description}</p><a class="card-link" href={mode.href}>{mode.cta}</a></article>)}</div><div class="contact-panel contact-panel--spaced"><div><h2>{page.talkTitle}</h2><p>{page.talkBody}</p></div><a class="button" href={profile.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="fab fa-whatsapp" /> {page.talkCta}</a></div></div></section>
</BaseLayout>
