---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, profile } from '../data/portfolio.js';
---
<BaseLayout title="Trayectoria | Jerson Martínez" description="Trayectoria de Jerson Martínez en DevOps, SRE, DevSecOps, cloud y liderazgo técnico." canonical={`${profile.website}/experience.html`}>
  <section class="page-hero"><div class="container"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Trayectoria / impacto operativo</p><h1>Experiencia construyendo sistemas y equipos que escalan.</h1><p class="lede">Más de nueve años conectando ingeniería, automatización y estrategia cloud para organizaciones y equipos de alto rendimiento.</p><div class="page-hero-meta"><span>2019 — actualidad</span><span>AWS · Azure · GCP</span><span>GitOps · FinOps · DevSecOps</span></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><p class="section-kicker">01 / recorrido</p><h2>Una carrera orientada a la confiabilidad.</h2><p class="lede">Cada etapa suma una perspectiva: delivery, plataforma, seguridad, costes y formación.</p><p class="data-note">Resumen editorial basado en el CV facilitado; los porcentajes son resultados reportados en cada experiencia.</p></div><div class="timeline">{experience.map(([period, role, company, description]) => <article class="timeline-item"><span class="timeline-dot" aria-hidden="true"></span><div class="card timeline-card"><header><div><h2>{role}</h2><span class="company">{company}</span></div><time>{period}</time></header><p>{description}</p></div></article>)}</div></div></section>
  <section class="section section--line"><div class="container"><div class="contact-panel"><div><p class="section-kicker">02 / documentos</p><h2>La experiencia completa está en el CV.</h2></div><a class="button" href="https://docs.google.com/document/d/1r-Hpl-3WV1qDlLiUWJZkZ_7XFxrU1WgezGiaQnSrSkw/edit?usp=sharing" target="_blank" rel="noopener noreferrer">Ver CV en español ↗</a></div></div></section>
</BaseLayout>
