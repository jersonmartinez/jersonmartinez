---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { cvLinks, experience, experienceLede, profile } from '../data/portfolio.js';
const experienceSchema = {
  '@context': 'https://schema.org', '@type': 'ProfilePage', name: 'Trayectoria profesional de Jerson Martínez', url: `${profile.website}/experience.html`, dateModified: '2026-09-30', mainEntity: { '@type': 'Person', name: profile.name, hasOccupation: experience.filter((item) => item.start >= '2019').map((item) => ({ '@type': 'Occupation', name: item.role, occupationLocation: { '@type': 'Country', name: 'Latinoamérica' } })) },
};
---
<BaseLayout title="Trayectoria DevOps y Cloud | Jerson Martínez" description="Más de diez años de proyectos, formación y experiencia de Jerson Martínez en DevOps, SRE, DevSecOps y cloud." canonical={`${profile.website}/experience.html`} breadcrumb={[['Inicio', '/'], ['Trayectoria', '/experience.html']]} structuredData={[experienceSchema]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Trayectoria</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Trayectoria / impacto operativo</p><h1>Experiencia construyendo sistemas y equipos que escalan.</h1><p class="lede">{experienceLede}</p><ul class="page-hero-meta" aria-label="Resumen de trayectoria"><li>2016 — actualidad</li><li>AWS · Azure · GCP</li><li>GitOps · FinOps · DevSecOps</li><li>Liderazgo · Consultoría · Formación</li></ul></div></section>
  <section class="section" aria-labelledby="exp-list-title"><div class="container"><div class="section-heading"><p class="section-kicker">01 / recorrido</p><h2 id="exp-list-title">Una carrera orientada a la confiabilidad.</h2><p class="lede">Se muestran experiencias seleccionadas y un periodo inicial de proyectos independientes, sin atribuir clientes o trabajos no publicados.</p></div><ol class="timeline" aria-label="Línea de tiempo profesional, de lo más reciente a lo anterior">{experience.map((item) => <li class="timeline-item" id={item.id}><span class="timeline-dot" aria-hidden="true"></span><article class="card timeline-card"><header><div><h3>{item.role}</h3><span class="company">{item.company}</span></div><time datetime={item.start}>{item.period}</time></header><p>{item.description}</p>{item.context && <p class="timeline-context"><Icon name="fas fa-info-circle" />{item.context}</p>}<div class="timeline-links">{item.related?.map((link) => <a class="card-link" href={link.href}>{link.label}</a>)}</div></article></li>)}</ol></div></section>
  <section class="section section--line" aria-labelledby="cv-title"><div class="container"><div class="contact-panel"><div><p class="section-kicker">02 / documentos</p><h2 id="cv-title">La experiencia completa está disponible en español e inglés.</h2></div><div class="contact-actions">{cvLinks.map((cv) => <a class="button button--ghost" href={cv.href} target="_blank" rel="noopener noreferrer" hreflang={cv.lang}>{cv.label}<span class="sr-only"> (abre en nueva pestaña)</span></a>)}<a class="button" href={profile.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="fab fa-whatsapp" /> Conversar</a></div></div></div></section>
</BaseLayout>
