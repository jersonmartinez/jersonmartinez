---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, profile, experienceLede } from '../data/portfolio.js';
---
<BaseLayout title="Trayectoria | Jerson Martínez" description="Trayectoria de Jerson Martínez en DevOps, SRE, DevSecOps, cloud y liderazgo técnico." canonical={`${profile.website}/experience.html`} breadcrumb={[['Inicio', '/'], ['Trayectoria', '/experience.html']]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Trayectoria</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Trayectoria / impacto operativo</p><h1>Experiencia construyendo sistemas y equipos que escalan.</h1><p class="lede">{experienceLede}</p><div class="page-hero-meta"><span>2019 — actualidad</span><span>AWS · Azure · GCP</span><span>GitOps · FinOps · DevSecOps</span></div></div></section>
  <section class="section" aria-labelledby="exp-list-title"><div class="container"><div class="section-heading"><p class="section-kicker">01 / recorrido</p><h2 id="exp-list-title">Una carrera orientada a la confiabilidad.</h2><p class="lede">Cada etapa suma una perspectiva: delivery, plataforma, seguridad, costes y formación.</p><p class="data-note">Resumen editorial basado en el CV facilitado; los porcentajes son resultados reportados en cada experiencia.</p></div><ol class="timeline" aria-label="Línea de tiempo profesional, de lo más reciente a lo anterior">{experience.map(([period, role, company, description]) => <li class="timeline-item"><span class="timeline-dot" aria-hidden="true"></span><div class="card timeline-card"><header><div><h3>{role}</h3><span class="company">{company}</span></div><time datetime={(period.match(/\d{4}/) || [''])[0]}>{period}</time></header><p>{description}</p></div></li>)}</ol></div></section>
  <section class="section section--line"><div class="container"><div class="contact-panel"><div><p class="section-kicker">02 / documentos</p><h2>La experiencia completa está en el CV.</h2></div><a class="button" href="https://docs.google.com/document/d/1r-Hpl-3WV1qDlLiUWJZkZ_7XFxrU1WgezGiaQnSrSkw/edit?usp=sharing" target="_blank" rel="noopener noreferrer" hreflang="es">Ver CV en español <i class="fas fa-external-link-alt" aria-hidden="true"></i><span class="sr-only"> (abre en nueva pestaña)</span></a></div></div></section>
</BaseLayout>
