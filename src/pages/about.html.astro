---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { collaborationModes, cvLinks, profile, stackGroups } from '../data/portfolio.js';
const profileSchema = { '@context': 'https://schema.org', '@type': 'ProfilePage', name: 'Sobre Jerson Martínez', url: `${profile.website}/about.html`, dateModified: '2026-09-30', mainEntity: { '@type': 'Person', name: profile.name, jobTitle: 'DevOps Tech Lead', knowsAbout: stackGroups.flatMap((group) => group.items) } };
---
<BaseLayout title="Sobre Jerson Martínez | DevOps y Cloud" description="Perfil profesional de Jerson Martínez: DevOps, SRE, DevSecOps, cloud, automatización, liderazgo y formación." canonical={`${profile.website}/about.html`} breadcrumb={[["Inicio", "/"], ["Sobre mí", "/about.html"]]} structuredData={[profileSchema]}>
  <section class="page-hero about-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Sobre mí</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Sobre mí / contexto profesional</p><h1>Ingeniería que conecta personas, plataformas y resultados.</h1><p class="lede">Más de {profile.yearsExperience} años combinando proyectos tecnológicos, desarrollo, operaciones e infraestructura cloud.</p><nav class="about-quick-links" aria-label="Atajos del perfil"><a class="button button--ghost" href="/experience.html"><Icon name="fas fa-route" /> Ver trayectoria</a><a class="button button--ghost" href="/projects.html"><Icon name="fas fa-project-diagram" /> Ver proyectos</a><a class="button button--ghost" href="/certifications.html"><Icon name="fas fa-certificate" /> Ver certificaciones</a></nav></div></section>
  <section class="section" aria-labelledby="about-story-title"><div class="container about-layout"><article class="about-story card"><picture class="about-portrait"><source srcset="/images/profile-v2-320.webp 320w, /images/profile-v2-640.webp 640w" sizes="(max-width: 900px) 86vw, 28vw" type="image/webp"/><img src="/images/profile-v2-640.jpg" width="640" height="640" alt="Jerson Martínez" loading="lazy" decoding="async"/></picture><p class="section-kicker">01 / historia</p><h2 id="about-story-title">Soy Jerson 👋</h2><p>Soy Ingeniero DevOps y en Telemática. Desde 2016 he conectado desarrollo, operaciones e infraestructura cloud para construir entornos robustos, eficientes y sostenibles.</p><p>Mi enfoque es generar impacto medible: reducir fricción operativa, automatizar delivery, fortalecer el gobierno y compartir conocimiento.</p><h3>Resultados que marcan la diferencia</h3><ul class="about-results"><li><strong>Costes:</strong> reducción reportada del 60% en infraestructura mediante rediseño arquitectónico y uso eficiente de recursos. <a href="/experience.html#hotaka-ikhodi">Ver contexto</a></li><li><strong>Delivery:</strong> pipelines CI/CD, GitHub Actions e IaC aplicados en liderazgo y consultoría. <a href="/experience.html">Ver trayectoria</a></li><li><strong>Operación:</strong> Infralytics, desarrollado en Python, permitió ejecutar acciones sobre servidores Windows y GNU/Linux desde una aplicación web. <a href="/experience.html#hotaka-ikhodi">Ver experiencia</a></li><li><strong>Formación:</strong> cursos y contenido en Udemy, OpenWebinars y YouTube. <a href="/courses.html">Ver formación</a></li></ul><p>También trabajo con automatización e infraestructura para aplicaciones de IA, asistentes GenAI y sistemas de agentes.</p><p>Mi objetivo es generar valor real mediante automatización, eficiencia y trabajo en equipo.</p></article><aside class="about-aside"><div class="card about-stack-card"><p class="section-kicker">02 / stack</p><h2>Capacidades organizadas por dominio.</h2><div class="stack-groups">{stackGroups.map((group) => <details><summary>{group.name}</summary><ul>{group.items.map((item) => <li>{item}</li>)}</ul></details>)}</div></div><div class="card about-credentials-card"><p class="section-kicker">03 / confianza</p><h3>AWS, Azure, GitHub y formación continua.</h3><p>Diez credenciales oficiales verificables, más de 100 certificaciones obtenidas y trabajo como autor e instructor.</p><div class="about-links"><a class="card-link" href="/certifications.html">Ver credenciales</a>{cvLinks.map((cv) => <a class="card-link" href={cv.href} target="_blank" rel="noopener noreferrer" hreflang={cv.lang}>{cv.label}<span class="sr-only"> (abre en nueva pestaña)</span></a>)}</div></div></aside></div></section>
  <section class="section section--line" aria-labelledby="collaboration-title"><div class="container"><div class="section-heading"><p class="section-kicker">04 / colaboración</p><h2 id="collaboration-title">Tres formas de crear valor juntos.</h2></div><div class="intent-grid">{collaborationModes.map((mode) => <article class="card card--interactive intent-card"><span class="intent-icon" aria-hidden="true"><Icon name={mode.icon} /></span><h3>{mode.title}</h3><p>{mode.description}</p><a class="card-link" href={mode.href}>{mode.cta}</a></article>)}</div><div class="contact-panel contact-panel--spaced"><div><h2>¿Te gustaría conversar?</h2><p>Estoy a un mensaje. Yo ya tengo el café listo, ¿y tú?</p></div><a class="button" href={profile.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="fab fa-whatsapp" /> Hablemos por WhatsApp</a></div></div></section>
</BaseLayout>
