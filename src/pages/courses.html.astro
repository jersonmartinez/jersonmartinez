---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courses, profile, youtubeChannels } from '../data/portfolio.js';

// Deriva el framework real desde el nombre del curso (sin inventar métricas ni datos).
const frameworkOf = (name) => {
  const found = ['Gin', 'Echo', 'Gorilla', 'Fiber', 'Revel'].find((fw) => name.includes(fw));
  if (found) return found;
  if (name.includes('Fundamentos')) return 'Fundamentos';
  return null;
};
const courseBlurb = (name) => {
  const fw = frameworkOf(name);
  if (fw === 'Fundamentos') return 'Curso sobre los fundamentos de los frameworks web en Go.';
  if (fw) return `Curso de desarrollo web en Go con el framework ${fw}.`;
  return 'Curso de desarrollo web en Go con Gin, Echo, Gorilla y Fiber.';
};
---
<BaseLayout title="Cursos | Jerson Martínez" description="Cursos de desarrollo web con Go y formación DevOps de Jerson Martínez." canonical={`${profile.website}/courses.html`}>
  <section class="page-hero"><div class="container"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Cursos / formación pública</p><h1>Conocimiento que se puede reutilizar.</h1><p class="lede">Siete cursos publicados en Udemy sobre desarrollo web con Go y frameworks como Gin, Echo, Gorilla, Fiber y Revel.</p><div class="page-hero-meta"><span>7 cursos</span><span>Más de 77 mil estudiantes</span><span>Go · Web · APIs</span></div></div></section>
  <section class="section"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">01 / Udemy</p><h2>Mis cursos (7).</h2><p class="lede">Una ruta de aprendizaje práctica para construir aplicaciones web con Go.</p></div><a class="button" href="https://www.udemy.com/user/side-master/" target="_blank" rel="noopener noreferrer">Ver perfil en Udemy <i class="fas fa-external-link-alt" aria-hidden="true"></i></a></div><div class="course-summary"><strong>Más de 77 mil estudiantes</strong><span>acumulados en el catálogo</span></div><div class="course-grid">{courses.map((course, index) => <article class="card course-card"><span class="card-label">CURSO / {String(index + 1).padStart(2, '0')}</span><h3>{course.name}</h3><p>{courseBlurb(course.name)}</p><a class="card-link" href={course.href} target="_blank" rel="noopener noreferrer">Abrir catálogo de Udemy <i class="fas fa-external-link-alt" aria-hidden="true"></i></a></article>)}</div><p class="data-note">La cifra de estudiantes corresponde al catálogo de Udemy mostrado en el perfil público y se presenta de forma redondeada; la plataforma puede actualizarla con el tiempo.</p></div></section>
  <section class="section section--line" id="canales"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">02 / canales</p><h2>Contenido que continúa después del curso.</h2><p class="lede">Los canales complementan los cursos con sesiones y materiales prácticos. YouTube muestra suscriptores redondeados.</p></div><a class="button button--ghost" href="/#enseñanza"><i class="fas fa-arrow-right" aria-hidden="true"></i> Ver Enseñanza en el inicio</a></div><div class="teaching-grid">{youtubeChannels.map((channel) => <article class="card teaching-card"><img src={channel.logo} width="32" height="32" alt={`${channel.name} logo`} loading="lazy" /><div><h3>{channel.name}</h3><strong class="teaching-metric">{channel.metric}</strong><p>{channel.description}</p></div><a href={channel.href} target="_blank" rel="noopener noreferrer">Abrir canal <i class="fas fa-external-link-alt" aria-hidden="true"></i></a></article>)}</div></div></section>
</BaseLayout>
