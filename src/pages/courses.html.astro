---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { audienceMetrics, courses, openWebinarsCourses, profile, youtubeChannels } from '../data/portfolio.js';
const courseSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Cursos de desarrollo web con Go',
  itemListElement: courses.map((course, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@type': 'Course', name: course.name, description: course.summary, url: course.href, inLanguage: 'es', provider: { '@type': 'Organization', name: 'Udemy', sameAs: 'https://www.udemy.com/' }, ...(course.free ? { isAccessibleForFree: true } : {}) } })),
};
---
<BaseLayout title="Cursos de Go y DevOps | Jerson Martínez" description="Ruta de cursos de desarrollo web con Go y formación pública impartida por Jerson Martínez." canonical={`${profile.website}/courses.html`} breadcrumb={[['Inicio', '/'], ['Cursos', '/courses.html']]} structuredData={[courseSchema]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Cursos</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Cursos / formación pública</p><h1>Una ruta práctica para aprender desarrollo web con Go.</h1><p class="lede">Empieza por fundamentos, compara enfoques y profundiza en Gin, Echo, Fiber, Gorilla y Revel.</p><ul class="page-hero-meta" aria-label="Resumen de formación"><li>7 cursos en Udemy</li><li>{audienceMetrics.udemy.label}</li><li>7 cursos en OpenWebinars</li><li>Go · Web · APIs</li></ul></div></section>
  <section class="section" aria-labelledby="courses-list-title"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">01 / ruta Udemy</p><h2 id="courses-list-title">De fundamentos a frameworks específicos.</h2><p class="lede">Siete etapas con un objetivo claro y enlaces directos a cada ficha pública.</p></div><a class="button" href="https://www.udemy.com/user/side-master/" target="_blank" rel="noopener noreferrer">Ver perfil en Udemy<span class="sr-only"> (abre en nueva pestaña)</span></a></div><div class="course-summary"><strong>{audienceMetrics.udemy.longLabel}</strong><span>en el catálogo confirmado</span></div><div class="course-grid">{courses.map((course, index) => <CourseCard course={course} index={index} />)}</div></div></section>
  <section class="section section--line" aria-labelledby="openwebinars-title"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">02 / OpenWebinars</p><h2 id="openwebinars-title">Siete formaciones con duración pública.</h2><p class="lede">El perfil de instructor reúne cursos de desarrollo web con Go y más de 60 artículos técnicos.</p></div><a class="button button--ghost" href="https://openwebinars.net/profesores/antoniomorenosm/" target="_blank" rel="noopener noreferrer">Ver perfil de instructor<span class="sr-only"> (abre en nueva pestaña)</span></a></div><div class="openwebinars-grid">{openWebinarsCourses.map((course) => <article class="card card--interactive compact-course"><img src="/brands/openwebinars.svg" width="44" height="44" alt="" loading="lazy"/><div><h3>{course.name}</h3><p>{course.duration}{course.rating ? ` · valoración ${course.rating}/5` : ''}</p><a class="card-link" href={course.href} target="_blank" rel="noopener noreferrer">Ver formación<span class="sr-only"> (abre en nueva pestaña)</span></a></div></article>)}</div></div></section>
  <section class="section" id="canales" aria-labelledby="channels-title"><div class="container"><div class="section-heading"><p class="section-kicker">03 / canales</p><h2 id="channels-title">Contenido que continúa después del curso.</h2><p class="lede">DevOpsea y Side Master complementan la formación con sesiones prácticas.</p></div><div class="teaching-grid">{youtubeChannels.map((channel) => <article class="card teaching-card card--interactive"><img src={channel.logo} width="40" height="40" alt="" loading="lazy" /><div><h3>{channel.name}</h3><strong class="teaching-metric">{channel.metric}</strong><p>{channel.description}</p></div><a href={channel.href} target="_blank" rel="noopener noreferrer">{channel.cta}<span class="sr-only"> (abre en nueva pestaña)</span></a></article>)}</div></div></section>
</BaseLayout>
