---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { courses, profile, youtubeChannels } from '../data/portfolio.js';

// Deriva el framework real desde el nombre del curso (sin inventar métricas ni datos).
const frameworkOf = (name) => {
  const found = ['Gin', 'Echo', 'Gorilla', 'Fiber', 'Revel'].find((fw) => name.includes(fw));
  if (found) return found;
  if (name.includes('Fundamentos')) return 'Fundamentos';
  return null;
};
const courseBlurb = (name) => {
  const fw = frameworkOf(name);
  if (fw === 'Fundamentos') return 'Curso sobre los fundamentos de los frameworks web en Go.';
  if (fw) return `Curso de desarrollo web en Go con el framework ${fw}.`;
  return 'Curso de desarrollo web en Go con Gin, Echo, Gorilla y Fiber.';
};
---
<BaseLayout title="Cursos | Jerson Martínez" description="Cursos de desarrollo web con Go y formación DevOps de Jerson Martínez." canonical={`${profile.website}/courses.html`} breadcrumb={[['Inicio', '/'], ['Cursos', '/courses.html']]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Cursos</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Cursos / formación pública</p><h1>Una ruta visual para aprender Go.</h1><p class="lede">Siete cursos publicados en Udemy para recorrer frameworks web de Go, desde fundamentos comparativos hasta aplicaciones con Gin, Echo, Gorilla, Fiber y Revel.</p><div class="page-hero-meta" role="list" aria-label="Resumen de cursos"><span role="listitem">7 cursos</span><span role="listitem">+77K estudiantes</span><span role="listitem">Go · Web · APIs</span><span role="listitem">1 curso gratis identificado</span></div></div></section>
  <section class="section" aria-labelledby="courses-list-title"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">01 / Udemy</p><h2 id="courses-list-title">Mis cursos (7).</h2><p class="lede">Una ruta de aprendizaje práctica para construir aplicaciones web con Go.</p></div><a class="button" href="https://www.udemy.com/user/side-master/" target="_blank" rel="noopener noreferrer">Ver perfil en Udemy <span class="sr-only"> (abre en nueva pestaña)</span></a></div><div class="course-summary"><strong>Más de 77 mil estudiantes</strong><span>acumulados en el catálogo</span></div><div class="course-grid">{courses.map((course, index) => <CourseCard course={course} index={index} total={courses.length} />)}</div><p class="data-note">La cifra de estudiantes se presenta con el copy confirmado para el catálogo; el estado gratuito se indica únicamente cuando la ficha pública consultada lo identifica.</p></div></section>
  <section class="section section--line" id="canales"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">02 / canales</p><h2>Contenido que continúa después del curso.</h2><p class="lede">Los canales complementan los cursos con sesiones y materiales prácticos. YouTube muestra suscriptores redondeados.</p></div><a class="button button--ghost" href="/#enseñanza"><i class="fas fa-arrow-right" aria-hidden="true"></i> Ver Enseñanza en el inicio</a></div><div class="teaching-grid">{youtubeChannels.map((channel) => <article class="card teaching-card"><img src={channel.logo} width="32" height="32" alt={`${channel.name} logo`} loading="lazy" decoding="async" /><div><h3>{channel.name}</h3><strong class="teaching-metric">{channel.metric}</strong><p>{channel.description}</p></div><a href={channel.href} target="_blank" rel="noopener noreferrer">{channel.cta}<span class="sr-only"> (abre en nueva pestaña)</span></a></article>)}</div></div></section>
</BaseLayout>
