---
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialCard from '../components/CredentialCard.astro';
import { audienceMetrics, certifications, cvLinks, profile } from '../data/portfolio.js';
const officialCount = certifications.reduce((total, provider) => total + provider.items.length, 0);
const credentialSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Certificaciones oficiales de Jerson Martínez',
  itemListElement: certifications.flatMap((provider) => provider.items.map((item) => ({ '@type': 'ListItem', position: 0, item: { '@type': 'EducationalOccupationalCredential', name: item.name, credentialCategory: item.level, recognizedBy: { '@type': 'Organization', name: provider.provider, ...(provider.issuerUrl ? { url: provider.issuerUrl } : {}) }, url: item.href, identifier: item.credentialId } }))).map((item, index) => ({ ...item, position: index + 1 })),
};
---
<BaseLayout title="Certificaciones AWS, Azure y GitHub | Jerson Martínez" description="Diez certificaciones oficiales de AWS, Microsoft Azure y GitHub Foundations con enlaces de verificación." canonical={`${profile.website}/certifications.html`} breadcrumb={[['Inicio', '/'], ['Certificaciones', '/certifications.html']]} structuredData={[credentialSchema]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Certificaciones</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Certificaciones / evidencia oficial</p><h1>Diez credenciales verificables para operar mejor.</h1><p class="lede">AWS, Microsoft Azure y GitHub Foundations respaldan arquitectura, plataforma, seguridad y delivery multi-cloud.</p><ul class="page-hero-meta" aria-label="Resumen de credenciales"><li>{officialCount} credenciales oficiales</li><li>3 AWS</li><li>6 Microsoft Azure</li><li>1 GitHub Foundations</li></ul></div></section>
  <section class="section" aria-labelledby="certs-list-title"><div class="container"><div class="section-heading"><p class="section-kicker">01 / certificaciones</p><h2 id="certs-list-title">Cada badge abre su fuente oficial.</h2><p class="lede">El nombre, nivel y credential ID permiten identificar cada certificación sin confundir competencias con credenciales.</p></div><div class="cert-grid cert-grid--badges">{certifications.map((certification) => <CredentialCard certification={certification} />)}</div></div></section>
  <section class="section section--line" aria-labelledby="learning-title"><div class="container"><div class="section-heading"><p class="section-kicker">02 / aprendizaje continuo</p><h2 id="learning-title">Más de 100 certificaciones obtenidas como estudiante.</h2><p class="lede">Formación continua en tecnología y humanidades desde diciembre de 2017, además del trabajo como escritor e instructor.</p></div><div class="learning-summary"><article class="card"><span class="card-label">Formación obtenida</span><strong>100+</strong><h3>Certificaciones y cursos</h3><p>OpenWebinars, Udemy, PluralSight, LinkedIn, Crashell y otras plataformas de aprendizaje.</p></article><article class="card"><span class="card-label">Autor</span><strong>{audienceMetrics.openWebinarsArticles.label}</strong><h3>Artículos publicados</h3><p>Contenido técnico sobre DevOps, cloud, observabilidad, Git y automatización.</p></article><article class="card"><span class="card-label">Instructor</span><strong>{audienceMetrics.openWebinarsCourses.label}</strong><h3>Formaciones en OpenWebinars</h3><p>Cursos públicos de desarrollo web con Go.</p></article></div></div></section>
  <section class="section" aria-labelledby="education-title"><div class="container"><div class="section-heading"><p class="section-kicker">03 / formación y documentos</p><h2 id="education-title">Ingeniería y CV bilingüe.</h2></div><div class="cards"><article class="card"><span class="card-label">Educación / 2013 — 2017</span><h3>Ingeniero en Telemática.</h3><p>UNAN — León. Graduado con honores; tesis GNet con una calificación de 100 puntos.</p><a class="card-link" href="https://github.com/jersonmartinez/GNet" target="_blank" rel="noopener noreferrer">Ver GNet<span class="sr-only"> (abre en nueva pestaña)</span></a></article>{cvLinks.map((cv) => <article class="card"><span class="card-label">CV / {cv.lang.toUpperCase()}</span><h3>{cv.label}</h3><p>Consulta la versión pública en Google Drive o descarga el PDF actualizado.</p><div class="card-actions"><a class="card-link" href={cv.href} target="_blank" rel="noopener noreferrer" hreflang={cv.lang}>Abrir en Google Drive<span class="sr-only"> (abre en nueva pestaña)</span></a><a class="card-link" href={cv.downloadHref} download type="application/pdf" hreflang={cv.lang}>Descargar PDF<span class="sr-only"> {cv.lang === 'es' ? 'en español' : 'en inglés'}</span></a></div></article>)}</div></div></section>
</BaseLayout>
