---
import BaseLayout from '../layouts/BaseLayout.astro';
import { certifications, cvLinks, profile } from '../data/portfolio.js';
---
<BaseLayout title="Credenciales | Jerson Martínez" description="Certificaciones, formación y fundamentos técnicos de Jerson Martínez." canonical={`${profile.website}/certifications.html`} breadcrumb={[['Inicio', '/'], ['Credenciales', '/certifications.html']]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Credenciales</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Credenciales / aprendizaje continuo</p><h1>Aprender para operar mejor.</h1><p class="lede">Más de 100 certificaciones y cursos en cloud, DevOps y desarrollo de software, construidos sobre una base de ingeniería en telemática.</p><div class="page-hero-meta"><span>AWS</span><span>Microsoft Azure</span><span>GitHub Foundations</span><span>100+ cursos</span></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><p class="section-kicker">01 / certificaciones</p><h2>Logos reconocibles. Contexto real.</h2><p class="lede">Una selección de credenciales que sostienen arquitectura, plataforma, seguridad y delivery.</p></div><div class="cert-grid">{certifications.map((cert) => <article class="card cert-card"><div class="cert-card-head"><img src={cert.logo} width="40" height="40" alt={`${cert.provider} logo`} loading="lazy" decoding="async" /><h3>{cert.provider}</h3></div><ul class="cert-list">{cert.items.map((item) => <li><a class="credential-link" href={item.href} target="_blank" rel="noopener noreferrer"><span>{item.name}</span><span class="credential-verify">Verificar <i class="fas fa-external-link-alt" aria-hidden="true"></i></span><span class="sr-only"> (abre en nueva pestaña)</span></a></li>)}</ul></article>)}</div><p class="disclaimer" style="margin-top: 1.5rem">Resumen basado en el CV facilitado. La verificación oficial de cada credencial corresponde a AWS, Microsoft y GitHub.</p></div></section>
  <section class="section section--line"><div class="container"><div class="cards"><article class="card"><span class="card-label">Education / 2013 — 2017</span><h3>Ingeniero en Telemática.</h3><p>UNAN — León. Graduado con honores; tesis GNet con una calificación de 100 puntos.</p><a class="card-link" href="https://github.com/jersonmartinez/GNet" target="_blank" rel="noopener noreferrer">Ver GNet <i class="fas fa-external-link-alt" aria-hidden="true"></i><span class="sr-only"> (abre en nueva pestaña)</span></a></article><article class="card"><span class="card-label">Learning / ongoing</span><h3>Formación pública.</h3><p>A Cloud Guru, OpenWebinars, Udemy, PluralSight, LinkedIn y Crashell, con más de 60 artículos publicados.</p><a class="card-link" href="https://www.udemy.com/user/side-master/" target="_blank" rel="noopener noreferrer">Ver Udemy <i class="fas fa-external-link-alt" aria-hidden="true"></i><span class="sr-only"> (abre en nueva pestaña)</span></a></article><article class="card"><span class="card-label">Documents / bilingual</span><h3>CV en dos idiomas.</h3><p>Consulta el detalle completo de responsabilidades, formación y certificaciones.</p>{cvLinks.map(([label, href]) => <a class="card-link" href={href} target="_blank" rel="noopener noreferrer" hreflang={label.includes('English') ? 'en' : 'es'}>{label} <i class="fas fa-external-link-alt" aria-hidden="true"></i><span class="sr-only"> (abre en nueva pestaña)</span></a>)}</article></div></div></section>
</BaseLayout>
