---
import BaseLayout from '../layouts/BaseLayout.astro';
import { certifications, cvLinks, profile } from '../data/portfolio.js';
const totalCredentials = certifications.reduce((total, cert) => total + cert.items.length, 0);
---
<BaseLayout title="Certificaciones | Jerson Martínez" description="Certificaciones y fundamentos técnicos de Jerson Martínez." canonical={`${profile.website}/certifications.html`} breadcrumb={[['Inicio', '/'], ['Certificaciones', '/certifications.html']]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Certificaciones</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Certificaciones / aprendizaje continuo</p><h1>Aprender para operar mejor.</h1><p class="lede">Certificaciones y formación en cloud, DevOps y desarrollo de software para sostener arquitectura, seguridad y delivery multi-cloud.</p><div class="page-hero-meta" role="list" aria-label="Emisores y volumen de credenciales"><span role="listitem">AWS</span><span role="listitem">Microsoft Azure</span><span role="listitem">GitHub Foundations</span><span role="listitem">100+ cursos</span></div></div></section>
  <section class="section" aria-labelledby="certs-list-title"><div class="container"><div class="section-heading"><p class="section-kicker">01 / certificaciones</p><h2 id="certs-list-title">Logos reconocibles. Contexto real.</h2><p class="lede">Una selección de credenciales que sostienen arquitectura, plataforma, seguridad y delivery.</p></div><div class="cert-grid">{certifications.map((cert) => <article class="card cert-card"><div class="cert-card-head"><img src={cert.logo} width="40" height="40" alt={`${cert.provider} logo`} loading="lazy" decoding="async" /><h3>{cert.provider}</h3></div><ul class="cert-list">{cert.items.map((item) => <li><a class="credential-link" href={item.href} target="_blank" rel="noopener noreferrer"><span>{item.name}</span><span class="sr-only"> (abre en nueva pestaña)</span></a></li>)}</ul></article>)}</div></div></section>
  <section class="section section--line" aria-labelledby="verify-title"><div class="container"><div class="section-heading"><p class="section-kicker">02 / verificación</p><h2 id="verify-title">Comprueba cada credencial en su fuente.</h2><p class="lede">Hay {totalCredentials} enlaces asociados a las credenciales y perfiles listados. La etiqueta de cada acción indica si abre una página oficial del emisor o un perfil relacionado.</p></div><ol class="verification-steps" aria-label="Pasos para comprobar una credencial"><li class="card verification-step"><span class="verification-step-icon" aria-hidden="true"><i class="fas fa-search"></i></span><span class="card-label">01 / elige</span><h3>Selecciona el emisor.</h3><p>Localiza AWS, Microsoft Azure o GitHub y el nombre de la credencial que quieres revisar.</p></li><li class="card verification-step"><span class="verification-step-icon" aria-hidden="true"><i class="fas fa-external-link-alt"></i></span><span class="card-label">02 / abre</span><h3>Usa la acción visible.</h3><p><strong>Abrir certificación</strong> abre un enlace oficial; <strong>Ver perfil</strong> identifica un recurso relacionado que no es un badge oficial.</p></li><li class="card verification-step"><span class="verification-step-icon" aria-hidden="true"><i class="fas fa-check-circle"></i></span><span class="card-label">03 / confirma</span><h3>Comprueba el emisor.</h3><p>La validación final corresponde siempre a AWS, Microsoft, GitHub, Credly o al proveedor que publica el recurso.</p></li></ol></div></section>
  <section class="section section--line"><div class="container"><div class="cards"><article class="card"><span class="card-label">Education / 2013 — 2017</span><h3>Ingeniero en Telemática.</h3><p>UNAN — León. Graduado con honores; tesis GNet con una calificación de 100 puntos.</p><a class="card-link" href="https://github.com/jersonmartinez/GNet" target="_blank" rel="noopener noreferrer">Ver GNet <span class="sr-only"> (abre en nueva pestaña)</span></a></article><article class="card"><span class="card-label">Learning / ongoing</span><h3>Formación pública.</h3><p>A Cloud Guru, OpenWebinars, Udemy, PluralSight, LinkedIn y Crashell, con más de 60 artículos publicados.</p><a class="card-link" href="https://www.udemy.com/user/side-master/" target="_blank" rel="noopener noreferrer">Ver Udemy <span class="sr-only"> (abre en nueva pestaña)</span></a></article><article class="card"><span class="card-label">Documents / bilingual</span><h3>CV en dos idiomas.</h3><p>Consulta el detalle completo de responsabilidades, formación y certificaciones.</p>{cvLinks.map(([label, href]) => <a class="card-link" href={href} target="_blank" rel="noopener noreferrer" hreflang={label.includes('English') ? 'en' : 'es'}>{label} <span class="sr-only"> (abre en nueva pestaña)</span></a>)}</article></div></div></section>
</BaseLayout>
