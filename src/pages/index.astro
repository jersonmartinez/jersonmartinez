---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoCloud from '../components/LogoCloud.astro';
import SkillsExplorer from '../components/SkillsExplorer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CredentialCard from '../components/CredentialCard.astro';
import { collaborationModes, profile, projects, teaching, certifications, skills } from '../data/portfolio.js';
const featuredProjects = projects.filter((project) => project.featured);
const logos = [
  { name: 'AWS', logo: '/brands/aws.svg' }, { name: 'Azure', logo: '/brands/azure.svg' },
  { name: 'GCP', logo: '/brands/googlecloud.svg' }, { name: 'Docker', logo: '/brands/docker.svg' },
  { name: 'Terraform', logo: '/brands/terraform.svg' }, { name: 'Kubernetes', logo: '/brands/kubernetes.svg' },
  { name: 'Python', logo: '/brands/python.svg' }, { name: 'Go', logo: '/brands/go.svg' },
];
---
<BaseLayout title="Jerson Martínez | DevOps, SRE y Cloud" description={profile.intro} preloadImage="/images/profile-v2-640.webp">
  <section class="hero" data-section="home">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> DEVOPS · SRE · DEVSECOPS · CLOUD</p>
        <h1>Plataformas cloud confiables para equipos que necesitan <em>avanzar.</em></h1>
        <p class="lede">{profile.intro} Conecto automatización, seguridad, costes y experiencia operativa para que los equipos puedan entregar con confianza.</p>
        <div class="hero-actions"><a class="button" href={profile.whatsapp} target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp" aria-hidden="true"></i> Hablemos por WhatsApp</a><a class="button button--ghost" href="#recorridos"><i class="fas fa-arrow-down" aria-hidden="true"></i> Elegir un recorrido</a></div>
        <ul class="hero-facts" aria-label="Resumen profesional">{profile.facts.map(([value, label, meta]) => <li>{meta?.href ? <a class="hero-fact-link" href={meta.href} {...(meta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} aria-label={meta.label}><strong>{value}</strong><span>{label}</span></a> : <><strong>{value}</strong><span>{label}</span></>}</li>)}</ul>
      </div>
      <aside class="profile-panel" aria-label="Perfil de Jerson Martínez">
        <div class="profile-image"><picture><source srcset="/images/profile-v2-320.webp 320w, /images/profile-v2-640.webp 640w, /images/profile-v2-960.webp 960w" sizes="(max-width: 640px) 88vw, 38vw" type="image/webp"/><img src="/images/profile-v2-640.jpg" srcset="/images/profile-v2-320.jpg 320w, /images/profile-v2-640.jpg 640w, /images/profile-v2-960.jpg 960w" sizes="(max-width: 640px) 88vw, 38vw" width="960" height="960" alt="Retrato de Jerson Martínez" fetchpriority="high" decoding="async" /></picture></div>
        <div class="profile-meta"><div><a class="profile-name" href="/about.html">Jerson Martínez</a><span>Sr. DevOps Engineer</span></div><span class="profile-tag">MULTI-CLOUD</span></div>
        <nav class="profile-links" aria-label="Perfiles públicos"><a class="profile-social" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub, abre en nueva pestaña" data-tooltip="GitHub"><i class="fab fa-github" aria-hidden="true"></i></a><a class="profile-social" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn, abre en nueva pestaña" data-tooltip="LinkedIn"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a><a class="profile-social" href="https://www.youtube.com/@DevOpsea" target="_blank" rel="noopener noreferrer" aria-label="DevOpsea en YouTube, abre en nueva pestaña" data-tooltip="DevOpsea"><i class="fab fa-youtube" aria-hidden="true"></i></a></nav>
      </aside>
    </div>
  </section>

  <section class="section section--tight intent-section" id="recorridos" aria-labelledby="recorridos-title">
    <div class="container"><div class="section-heading"><p class="section-kicker">Elige tu recorrido</p><h2 id="recorridos-title">La evidencia adecuada para cada conversación.</h2><p class="lede">Accede directamente a experiencia profesional, soluciones técnicas o formación.</p></div><div class="intent-grid">{collaborationModes.map((mode) => <article class="card card--interactive intent-card"><span class="intent-icon" aria-hidden="true"><i class={`fas ${mode.icon}`}></i></span><h3>{mode.title}</h3><p>{mode.description}</p><a class="card-link" href={mode.href}>{mode.cta}</a></article>)}</div></div>
  </section>

  <section class="section section--line" id="impacto" data-section="impacto" aria-labelledby="impacto-title">
    <div class="container journey">
      <nav class="journey-rail" aria-label="Recorrido del inicio"><a href="#impacto">Impacto</a><a href="#skills">Skills</a><a href="#proyectos">Proyectos</a><a href="#ensenanza">Formación</a><a href="#certificaciones">Certificaciones</a><a href="#contacto">Contacto</a></nav>
      <div class="journey-content"><div class="section-heading"><p class="section-kicker">01 / enfoque</p><h2 id="impacto-title">Plataformas que se pueden gobernar, medir y mejorar.</h2><p class="lede">La automatización conecta delivery, seguridad, costes y decisiones de negocio.</p></div><div class="cards impact-cards"><article class="card"><span class="card-label">Platform engineering</span><h3>Cloud con una base operable.</h3><p>Landing Zones, IaC, pipelines y estándares para que cada equipo pueda entregar sin reinventar la plataforma.</p><a class="card-link" href="/experience.html">Ver experiencia cloud</a></article><article class="card"><span class="card-label">AI + DevOps</span><h3>Automatización aumentada.</h3><p>Asistentes GenAI, agentes y MCP conectan conocimiento, herramientas y acciones con controles claros.</p><a class="card-link" href="/projects.html#proyecto-kiro-crew">Ver sistemas de agentes</a></article><article class="card"><span class="card-label">Governance</span><h3>Seguridad como sistema.</h3><p>GitOps, FinOps y DevSecOps integrados en el ciclo de vida, con trazabilidad y responsabilidad compartida.</p><a class="card-link" href="/experience.html#pliret-prb">Ver experiencia de gobierno</a></article></div><div class="logo-cloud-wrap"><LogoCloud items={logos} /></div></div>
    </div>
  </section>

  <section class="section section--line" id="skills" data-section="skills" aria-labelledby="skills-title"><div class="container"><div class="section-heading"><p class="section-kicker">02 / habilidades</p><h2 id="skills-title">Capacidades técnicas conectadas con evidencia.</h2><p class="lede">Selecciona un dominio para ver tecnologías, contexto de uso y experiencias relacionadas.</p></div><SkillsExplorer skills={skills} /></div></section>

  <section class="section" id="proyectos" data-section="proyectos" aria-labelledby="proyectos-title"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">03 / sistemas</p><h2 id="proyectos-title">Proyectos que explican cómo trabajo.</h2><p class="lede">Cada ficha conecta un problema, una contribución y un resultado verificable.</p></div><a class="button button--ghost" href="/projects.html"><i class="fas fa-arrow-right" aria-hidden="true"></i> Explorar todos</a></div><div class="featured-grid">{featuredProjects.map((project) => <ProjectCard project={project} featured />)}</div></div></section>

  <section class="section section--line" id="ensenanza" data-section="ensenanza" aria-labelledby="ensenanza-title"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">04 / conocimiento</p><h2 id="ensenanza-title">La enseñanza también es una plataforma.</h2><p class="lede">Cursos, artículos y canales convierten experiencia de operación en conocimiento reutilizable.</p></div><div class="head-row-actions"><a class="button button--ghost" href="/courses.html"><i class="fas fa-graduation-cap" aria-hidden="true"></i> Ver cursos</a><a class="button button--ghost" href="/courses.html#canales"><i class="fas fa-play" aria-hidden="true"></i> Ver canales</a></div></div><div class="teaching-grid">{teaching.map((item) => <article class="card teaching-card card--interactive"><img src={item.logo} width="40" height="40" alt="" loading="lazy" decoding="async" /><div><h3>{item.name}</h3><div class="teaching-metrics">{item.metrics.map((metric) => <strong>{metric}</strong>)}</div><p>{item.description}</p></div><a href={item.href} target="_blank" rel="noopener noreferrer">{item.cta}<span class="sr-only"> (abre en nueva pestaña)</span></a></article>)}</div></div></section>

  <section class="section" id="certificaciones" data-section="certificaciones" aria-labelledby="certificaciones-title"><div class="container"><div class="section-head-row"><div class="section-heading"><p class="section-kicker">05 / evidencia</p><h2 id="certificaciones-title">Diez credenciales oficiales y verificables.</h2><p class="lede">AWS, Microsoft Azure y GitHub Foundations respaldan arquitectura, seguridad, delivery y operación multi-cloud.</p></div><a class="button button--ghost" href="/certifications.html"><i class="fas fa-certificate" aria-hidden="true"></i> Ver credenciales</a></div><div class="cert-grid cert-grid--badges cert-grid--summary">{certifications.map((cert) => <CredentialCard certification={cert} summary limit={3} />)}</div></div></section>

  <section class="section section--tight" id="contacto" data-section="contacto" aria-labelledby="contacto-title"><div class="container"><div class="contact-panel"><div><p class="section-kicker">06 / siguiente paso</p><h2 id="contacto-title">¿Qué plataforma necesitas hacer confiable?</h2><p>Podemos conversar sobre una oportunidad profesional, consultoría o formación técnica.</p></div><div class="contact-actions"><a class="button" href={profile.whatsapp} target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp" aria-hidden="true"></i> Escribir por WhatsApp</a><a class="button button--ghost" href="/about.html">Conocer mi perfil</a></div></div></div></section>
</BaseLayout>
