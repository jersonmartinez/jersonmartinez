---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, profile } from '../data/portfolio.js';
const filters = [['all', 'Todos'], ['personal', 'Personales'], ['open-source', 'Open source'], ['teaching', 'Contenido y formación']];
const counts = Object.fromEntries(filters.map(([key]) => [key, key === 'all' ? projects.length : projects.filter((project) => project.categories.includes(key)).length]));
const projectSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Proyectos de Jerson Martínez',
  itemListElement: projects.map((project, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@type': project.name === 'Factib' ? 'WebApplication' : 'SoftwareSourceCode', name: project.name, description: project.description, ...(project.href ? { url: project.href } : {}), ...(project.language ? { programmingLanguage: project.language } : {}), ...(project.license ? { license: project.license } : {}) } })),
};
---
<BaseLayout title="Proyectos DevOps y Cloud | Jerson Martínez" description="Casos de producto, automatización, open source, cloud y formación desarrollados por Jerson Martínez." canonical={`${profile.website}/projects.html`} breadcrumb={[['Inicio', '/'], ['Proyectos', '/projects.html']]} structuredData={[projectSchema]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><span aria-current="page">Proyectos</span></li></ol></nav><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Proyectos / casos verificables</p><h1>Sistemas que muestran cómo convierto problemas en operación.</h1><p class="lede">Productos personales, repositorios públicos, automatizaciones y contenido técnico explicados por problema, contribución y resultado.</p><ul class="page-hero-meta" aria-label="Resumen de proyectos"><li>{projects.length} proyectos</li><li>Producto</li><li>Open source</li><li>Automatización</li><li>Formación</li></ul></div></section>
  <section class="section" aria-labelledby="projects-list-title"><div class="container"><div class="section-heading"><p class="section-kicker">01 / portfolio técnico</p><h2 id="projects-list-title">Filtra por el tipo de valor que buscas.</h2><p class="lede">Un proyecto puede pertenecer a más de un recorrido: producto, open source o formación.</p></div><div class="filter-bar" role="group" aria-label="Filtrar proyectos">{filters.map(([value, label], index) => <button class={`filter-button ${index === 0 ? 'is-active' : ''}`} type="button" data-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>{label} <span class="filter-count" aria-hidden="true">({counts[value]})</span></button>)}</div><p class="filter-status" data-filter-status role="status" aria-live="polite">Mostrando {projects.length} de {projects.length} proyectos</p><noscript><p class="data-note">La lista completa permanece disponible; activa JavaScript para filtrar por categoría.</p></noscript><div class="repo-grid">{projects.map((project) => <ProjectCard project={project} />)}</div><p class="repo-empty" data-repo-empty hidden>No hay proyectos para este filtro.</p></div></section>
  <section class="section section--line" aria-labelledby="projects-next-title"><div class="container"><div class="contact-panel"><div><p class="section-kicker">02 / siguiente paso</p><h2 id="projects-next-title">¿Quieres profundizar en experiencia o conversar sobre una solución?</h2></div><div class="contact-actions"><a class="button button--ghost" href="/experience.html">Ver trayectoria</a><a class="button" href={profile.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="fab fa-whatsapp" /> Contactar por WhatsApp</a></div></div></div></section>
</BaseLayout>
