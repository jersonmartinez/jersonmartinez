{
  "name": "jersonmartinez-portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Astro portfolio for Jerson Martínez — DevOps Engineer, SRE, DevSecOps and Cloud Architect.",
  "type": "commonjs",
  "homepage": "https://www.jersonmartinez.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jersonmartinez/jersonmartinez.git"
  },
  "bugs": {
    "url": "https://github.com/jersonmartinez/jersonmartinez/issues"
  },
  "author": {
    "name": "Jerson Martínez",
    "email": "jersonmartinezsm@gmail.com",
    "url": "https://www.jersonmartinez.com"
  },
  "keywords": [
    "devops",
    "sre",
    "devsecops",
    "cloud",
    "aws",
    "azure",
    "terraform",
    "astro",
    "portfolio"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "test": "node --test",
    "lint:css": "stylelint \"src/styles/*.css\"",
    "validate": "node tools/validate-site.js",
    "validate:sprite": "node tools/check-sprite-geometry.js",
    "validate:design": "node tools/check-design-metrics.cjs",
    "links": "node tools/check-links.js",
    "links:external": "node tools/check-links.js --external",
    "sitemap": "node tools/gen-sitemap.js",
    "sitemap:check": "node tools/gen-sitemap.js --check",
    "assets:generate": "python3 tools/generate-visual-assets.py",
    "headers": "node tools/check-headers.js",
    "sync:static": "node tools/sync-public-root.js",
    "sync:static:check": "node tools/sync-public-root.js --check",
    "content:health": "node tools/check-content-health.js",
    "youtube:dry-run": "node src/js/update-youtube-sections.js --dry-run --offline",
    "github:stats": "node tools/update-github-stats.js",
    "github:stats:check": "node tools/update-github-stats.js --check",
    "production:smoke": "node tools/check-production.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "astro": "7.3.5",
    "stylelint": "17.16.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3"
  }
}
