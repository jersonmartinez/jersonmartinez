{
  "name": "jersonmartinez-portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Astro portfolio for Jerson Martínez — DevOps Engineer, SRE, DevSecOps and Cloud Architect.",
  "type": "commonjs",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test",
    "validate": "node tools/validate-site.js",
    "links": "node tools/check-links.js",
    "links:external": "node tools/check-links.js --external",
    "assets:generate": "python3 tools/generate-visual-assets.py",
    "headers": "node tools/check-headers.js",
    "sync:static": "node tools/sync-public-root.js",
    "sync:static:check": "node tools/sync-public-root.js --check",
    "content:health": "node tools/check-content-health.js",
    "youtube:dry-run": "node src/js/update-youtube-sections.js --dry-run --offline",
    "github:stats": "node tools/update-github-stats.js",
    "github:stats:check": "node tools/update-github-stats.js --check",
    "production:smoke": "node tools/check-production.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "astro": "7.3.5"
  }
}
